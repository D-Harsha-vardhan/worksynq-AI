# WorkSynq AI - Environment Configuration Example
# Copy this file to .env and configure your keys

# DronaHQ Autonomous AI Agent Webhook Configuration
VITE_DRONAHQ_WEBHOOK_URL=https://agents-backend.dronahq.com/webhook/your-webhook-id
VITE_DRONAHQ_API_KEY=your_dronahq_api_key

# Optional NVIDIA NIM Inference API Key
VITE_NVIDIA_API_KEY=
